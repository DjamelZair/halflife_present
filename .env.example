# copy this file to .env and fill in what you have, everything is optional for a local demo

# secret topic name for ntfy, make it long and random, anyone who knows it can read the pushes
NTFY_TOPIC=
# link that opens when he taps the push, the app on GitHub Pages
APP_URL=

# optional, NCBI asks for an email and gives more requests with a free key
NCBI_EMAIL=
NCBI_API_KEY=

# optional, the last fallback for "used for" and "how it works". never put the real key anywhere but .env and the GitHub secret
SERPAPI_KEY=

# optional, leave empty for plain mode without summaries
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
ADMIN_NTFY_TOPIC=
