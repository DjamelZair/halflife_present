{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What the app needs from brief.json",
  "type": "object",
  "required": ["date", "mode", "demo", "status", "cards", "molecule", "pair"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mode": { "enum": ["fallback", "claude"] },
    "demo": { "type": "boolean" },
    "status": {
      "type": "object",
      "required": ["counts", "errors"],
      "properties": {
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "errors": { "type": "object" }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "what", "source", "url", "lane"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "what": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "lane": { "enum": ["clinic", "discovery", "toxicology"] },
          "topic": { "type": "string" },
          "headline": { "type": "string" }
        }
      }
    },
    "molecule": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["name", "smiles", "source", "Formula", "Molecular weight", "logP", "TPSA"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "smiles": { "type": "string", "minLength": 1 },
            "source": { "type": "string" },
            "url": { "type": "string" },
            "Formula": { "type": "string", "minLength": 1 },
            "Molecular weight": { "type": "number" },
            "logP": { "type": "number" },
            "TPSA": { "type": "number" },
            "reason": {
              "type": "object",
              "required": ["kind", "text"],
              "properties": { "kind": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "url": { "type": ["string", "null"] } }
            },
            "atc_status": { "enum": ["assigned", "none", "unknown"] },
            "atc": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code", "levels"],
                "properties": { "code": { "type": "string" }, "levels": { "type": "array" }, "substance": { "type": ["string", "null"] } }
              }
            },
            "used_for": {
              "oneOf": [
                { "type": "null" },
                { "type": "object", "required": ["text", "source"], "properties": { "text": { "type": "string", "minLength": 1 } } }
              ]
            },
            "mechanisms": {
              "type": "array",
              "items": { "type": "object", "required": ["text", "source"] }
            }
          }
        }
      ]
    },
    "pair": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["a", "b", "sentences", "illustrative_auc_ratio", "category"],
          "properties": {
            "a": { "type": "string", "minLength": 1 },
            "b": { "type": "string", "minLength": 1 },
            "sentences": { "type": "array", "items": { "type": "string" } },
            "illustrative_auc_ratio": { "type": ["number", "null"] },
            "category": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
